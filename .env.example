# Copy to .env and fill in values

MONGODB_URI=mongodb://127.0.0.1:27017/template

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Transactional email via Resend (optional — password reset)
RESEND_API_KEY=
EMAIL_FROM=
# Or use the pair below instead of EMAIL_FROM
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=YourApp

# Per-user API tokens (optional prefix for automation PATs)
AGENT_KEY_PREFIX=app_

PORT=3001
